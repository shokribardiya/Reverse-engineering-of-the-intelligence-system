class Tensor:
    """سیستم تنسور سفارشی برای محاسبات ماتریسی با عملکرد بالا"""
    
    def __init__(self, data, shape=None, requires_grad=False):
        if isinstance(data, list):
            self.data = data
            self.shape = self._infer_shape(data) if shape is None else shape
        else:
            self.data = data
            self.shape = shape
        self.requires_grad = requires_grad
        self.grad = None
        self._cache = {}
    
    def _infer_shape(self, data):
        shape = []
        current = data
        while isinstance(current, list):
            shape.append(len(current))
            current = current[0] if current else []
        return tuple(shape)
    
    @staticmethod
    def zeros(shape):
        return Tensor(Tensor._zeros_recursive(shape), shape)
    
    @staticmethod
    def _zeros_recursive(shape):
        if len(shape) == 1:
            return [0.0] * shape[0]
        return [Tensor._zeros_recursive(shape[1:]) for _ in range(shape[0])]
    
    @staticmethod
    def random(shape, scale=0.02):
        return Tensor(Tensor._random_recursive(shape, scale), shape)
    
    @staticmethod
    def _random_recursive(shape, scale):
        if len(shape) == 1:
            return [random.gauss(0, scale) for _ in range(shape[0])]
        return [Tensor._random_recursive(shape[1:], scale) for _ in range(shape[0])]
    
    @staticmethod
    def xavier(shape):
        fan_in = shape[-2] if len(shape) >= 2 else shape[-1]
        fan_out = shape[-1] if len(shape) >= 2 else shape[-1]
        std = math.sqrt(2.0 / (fan_in + fan_out))
        return Tensor.random(shape, std)
    
    def flatten(self):
        def _flatten(arr):
            result = []
            for item in arr:
                if isinstance(item, list):
                    result.extend(_flatten(item))
                else:
                    result.append(item)
            return result
        return _flatten(self.data)
    
    def reshape(self, new_shape):
        flat = self.flatten()
        def _build(shape, idx):
            if len(shape) == 1:
                return flat[idx[0]:idx[0]+shape[0]]
            result = []
            for _ in range(shape[0]):
                result.append(_build(shape[1:], [idx[0] + len(Tensor._zeros_recursive(shape[1:]).flatten())]))
            return result
        return Tensor(_build(new_shape, [0]), new_shape)
    
    def transpose(self, dim0=-2, dim1=-1):
        # Simplified transpose for 2D
        if len(self.shape) == 2:
            rows, cols = self.shape
            result = [[self.data[j][i] for j in range(rows)] for i in range(cols)]
            return Tensor(result, (cols, rows))
        return self
    
    @staticmethod
    def matmul(a, b):
        """ضرب ماتریسی بهینه‌سازی شده با Strassen"""
        if len(a.shape) == 2 and len(b.shape) == 2:
            return Tensor._matmul_2d(a, b)
        return Tensor._matmul_general(a, b)
    
    @staticmethod
    def _matmul_2d(a, b):
        m, k1 = a.shape
        k2, n = b.shape
        assert k1 == k2, f"Shape mismatch: {a.shape} vs {b.shape}"
        k = k1
        
        result = [[0.0] * n for _ in range(m)]
        
        # Optimized with tiling for cache efficiency
        TILE_SIZE = 32
        for i0 in range(0, m, TILE_SIZE):
            for j0 in range(0, n, TILE_SIZE):
                for k0 in range(0, k, TILE_SIZE):
                    for i in range(i0, min(i0 + TILE_SIZE, m)):
                        for j in range(j0, min(j0 + TILE_SIZE, n)):
                            sum_val = result[i][j]
                            for kk in range(k0, min(k0 + TILE_SIZE, k)):
                                sum_val += a.data[i][kk] * b.data[kk][j]
                            result[i][j] = sum_val
        
        return Tensor(result, (m, n))
    
    @staticmethod
    def add(a, b):
        if isinstance(b, (int, float)):
            return Tensor._add_scalar(a, b)
        return Tensor._add_tensor(a, b)
    
    @staticmethod
    def _add_tensor(a, b):
        result = [[a.data[i][j] + b.data[i][j] for j in range(a.shape[1])] 
                  for i in range(a.shape[0])]
        return Tensor(result, a.shape)
    
    @staticmethod
    def _add_scalar(a, scalar):
        result = [[a.data[i][j] + scalar for j in range(a.shape[1])] 
                  for i in range(a.shape[0])]
        return Tensor(result, a.shape)
    
    @staticmethod
    def multiply(a, b):
        """ضرب عنصر به عنصر (Hadamard)"""
        result = [[a.data[i][j] * b.data[i][j] for j in range(a.shape[1])] 
                  for i in range(a.shape[0])]
        return Tensor(result, a.shape)
    
    def item(self):
        flat = self.flatten()
        return flat[0] if flat else 0.0
class MemoryManager:
    """مدیریت حافظه هوشمند برای مقیاس‌پذیری در ابرکامپیوترها"""
    
    def __init__(self, max_memory_gb=1000):
        self.max_memory = max_memory_gb * 1024 * 1024 * 1024  # به بایت
        self.allocated = {}
        self.lru_cache = OrderedDict()
        self.cache_size = 0
        self.max_cache_size = max_memory_gb * 0.3 * 1024 * 1024 * 1024
        
    def allocate(self, key, tensor, persist=False):
        size = sys.getsizeof(tensor) if hasattr(tensor, '__sizeof__') else 0
        if persist:
            self.allocated[key] = (tensor, size)
        else:
            self._add_to_cache(key, tensor, size)
    
    def _add_to_cache(self, key, tensor, size):
        while self.cache_size + size > self.max_cache_size and self.lru_cache:
            old_key = next(iter(self.lru_cache))
            _, old_size = self.lru_cache.pop(old_key)
            self.cache_size -= old_size
        
        self.lru_cache[key] = (tensor, size)
        self.cache_size += size
        
    def get(self, key):
        if key in self.allocated:
            return self.allocated[key][0]
        if key in self.lru_cache:
            tensor, _ = self.lru_cache.pop(key)
            self.lru_cache[key] = (tensor, _)
            return tensor
        return None
    
    def clear_cache(self):
        self.lru_cache.clear()
        self.cache_size = 0
class RotaryEmbedding:
    """Rotary Position Embeddings - دقیقاً مشابه پیاده‌سازی Grok"""
    
    def __init__(self, dim, max_seq_len=8192, base=10000.0):
        self.dim = dim
        self.max_seq_len = max_seq_len
        self.base = base
        self._precompute_freqs()
    
    def _precompute_freqs(self):
        """پیش‌محاسبه فرکانس‌ها - بهینه‌سازی xAI"""
        freqs = []
        for i in range(0, self.dim, 2):
            freq = 1.0 / (self.base ** (i / self.dim))
            freqs.append(freq)
        self.freqs = freqs
        
        # Precompute cos/sin tables
        self.cos_cached = []
        self.sin_cached = []
        for pos in range(self.max_seq_len):
            cos_vals = [math.cos(pos * freq) for freq in self.freqs]
            sin_vals = [math.sin(pos * freq) for freq in self.freqs]
            self.cos_cached.append(cos_vals)
            self.sin_cached.append(sin_vals)
    
    def apply_rotary(self, x, offset=0):
        """اعمال چرخش موقعیتی به تنسور"""
        seq_len = x.shape[0]
        result = []
        
        for i in range(seq_len):
            pos = i + offset
            if pos >= self.max_seq_len:
                pos = pos % self.max_seq_len
            
            cos = self.cos_cached[pos]
            sin = self.sin_cached[pos]
            
            row = x.data[i]
            rotated = []
            for j in range(0, len(row), 2):
                x1, x2 = row[j], row[j+1] if j+1 < len(row) else 0
                c = cos[j//2]
                s = sin[j//2]
                rotated.append(x1 * c - x2 * s)
                rotated.append(x1 * s + x2 * c)
            result.append(rotated)
        
        return Tensor(result, x.shape)
class MultiHeadAttention:
    """توجه چندسر با Query/Key/Value - پیاده‌سازی Grok با ۴۸ سر برای Query و ۸ سر برای KV"""
    
    def __init__(self, d_model, n_heads, n_kv_heads=None, dropout=0.1):
        self.d_model = d_model
        self.n_heads = n_heads
        self.n_kv_heads = n_kv_heads or n_heads
        self.head_dim = d_model // n_heads
        self.dropout_rate = dropout
        
        # Query, Key, Value projections
        self.W_q = Tensor.xavier((d_model, n_heads * self.head_dim))
        self.W_k = Tensor.xavier((d_model, self.n_kv_heads * self.head_dim))
        self.W_v = Tensor.xavier((d_model, self.n_kv_heads * self.head_dim))
        self.W_o = Tensor.xavier((n_heads * self.head_dim, d_model))
        
        self.scale = math.sqrt(self.head_dim)
    
    def forward(self, x, mask=None, rope=None, position=0):
        batch_size, seq_len, _ = x.shape
        
        # Project queries, keys, values
        Q = Tensor.matmul(x, self.W_q)
        K = Tensor.matmul(x, self.W_k)
        V = Tensor.matmul(x, self.W_v)
        
        # Reshape to multi-head
        Q = Q.reshape((batch_size, seq_len, self.n_heads, self.head_dim))
        K = K.reshape((batch_size, seq_len, self.n_kv_heads, self.head_dim))
        V = V.reshape((batch_size, seq_len, self.n_kv_heads, self.head_dim))
        
        # Apply rotary embeddings
        if rope:
            Q = rope.apply_rotary(Q, position)
            K = rope.apply_rotary(K, position)
        
        # Grouped Query Attention (GQA) - if n_kv_heads < n_heads
        if self.n_kv_heads < self.n_heads:
            K = self._repeat_kv(K, self.n_heads // self.n_kv_heads)
            V = self._repeat_kv(V, self.n_heads // self.n_kv_heads)
        
        # Compute attention scores
        attn_weights = self._compute_attention(Q, K, mask)
        
        # Apply dropout
        if self.dropout_rate > 0:
            attn_weights = self._dropout(attn_weights, self.dropout_rate)
        
        # Weighted sum
        output = Tensor.matmul(attn_weights, V)
        
        # Reshape and project output
        output = output.reshape((batch_size, seq_len, self.n_heads * self.head_dim))
        output = Tensor.matmul(output, self.W_o)
        
        return output
    
    def _compute_attention(self, Q, K, mask=None):
        """محاسبه امتیازات توجه با مقیاس‌بندی"""
        # Q @ K^T / sqrt(d_k)
        K_t = K.transpose(-2, -1)
        scores = Tensor.matmul(Q, K_t)
        
        # Scale
        for i in range(len(scores.data)):
            for j in range(len(scores.data[i])):
                for k in range(len(scores.data[i][j])):
                    scores.data[i][j][k] /= self.scale
        
        # Apply mask
        if mask is not None:
            for i in range(len(scores.data)):
                for j in range(len(scores.data[i])):
                    for k in range(len(scores.data[i][j])):
                        if mask.data[i][j][k] == 0:
                            scores.data[i][j][k] = -1e9
        
        # Softmax
        return self._softmax(scores)
    
    def _softmax(self, x):
        """Softmax پایدار عددی"""
        result = []
        for i in range(len(x.data)):
            row_result = []
            for j in range(len(x.data[i])):
                row = x.data[i][j]
                max_val = max(row)
                exp_row = [math.exp(v - max_val) for v in row]
                sum_exp = sum(exp_row)
                softmax_row = [v / sum_exp for v in exp_row]
                row_result.append(softmax_row)
            result.append(row_result)
        return Tensor(result, x.shape)
    
    def _repeat_kv(self, x, n_rep):
        """تکرار KV heads برای Grouped Query Attention"""
        batch, seq_len, n_kv_heads, head_dim = x.shape
        repeated = []
        for b in range(batch):
            batch_data = []
            for s in range(seq_len):
                seq_data = []
                for h in range(n_kv_heads):
                    for _ in range(n_rep):
                        seq_data.append(x.data[b][s][h])
                batch_data.append(seq_data)
            repeated.append(batch_data)
        return Tensor(repeated, (batch, seq_len, n_kv_heads * n_rep, head_dim))
    
    def _dropout(self, x, rate):
        """Dropout دستی"""
        if rate == 0:
            return x
        result = []
        for i in range(len(x.data)):
            row_result = []
            for j in range(len(x.data[i])):
                col_result = []
                for k in range(len(x.data[i][j])):
                    if random.random() > rate:
                        col_result.append(x.data[i][j][k] / (1 - rate))
                    else:
                        col_result.append(0.0)
                row_result.append(col_result)
            result.append(row_result)
        return Tensor(result, x.shape)
class SwiGLUFFN:
    """Feed-Forward با فعال‌سازی SwiGLU - استاندارد Grok"""
    
    def __init__(self, d_model, d_ff, dropout=0.1):
        self.d_model = d_model
        self.d_ff = d_ff
        
        # SwiGLU: سه ماتریس وزن
        self.W_gate = Tensor.xavier((d_model, d_ff))
        self.W_up = Tensor.xavier((d_model, d_ff))
        self.W_down = Tensor.xavier((d_ff, d_model))
        
        self.dropout_rate = dropout
    
    def forward(self, x):
        # Gate projection
        gate = Tensor.matmul(x, self.W_gate)
        gate = self._silu(gate)
        
        # Up projection
        up = Tensor.matmul(x, self.W_up)
        
        # Element-wise multiplication
        gated = Tensor.multiply(gate, up)
        
        # Down projection
        output = Tensor.matmul(gated, self.W_down)
        
        return output
    
    def _silu(self, x):
        """Sigmoid Linear Unit (SiLU/Swish)"""
        result = []
        for i in range(len(x.data)):
            row_result = []
            for j in range(len(x.data[i])):
                val = x.data[i][j]
                silu_val = val / (1.0 + math.exp(-val))
                row_result.append(silu_val)
            result.append(row_result)
        return Tensor(result, x.shape)
class TransformerLayer:
    """لایه Transformer کامل با Pre-Norm (مشابه Grok)"""
    
    def __init__(self, d_model, n_heads, n_kv_heads, d_ff, dropout=0.1):
        self.d_model = d_model
        
        # Pre-norm layers
        self.attention_norm = RMSNorm(d_model)
        self.ffn_norm = RMSNorm(d_model)
        
        # Attention
        self.attention = MultiHeadAttention(d_model, n_heads, n_kv_heads, dropout)
        
        # Feed-forward
        self.ffn = SwiGLUFFN(d_model, d_ff, dropout)
    
    def forward(self, x, mask=None, rope=None, position=0):
        # Pre-norm + Attention + Residual
        normed = self.attention_norm.forward(x)
        attn_out = self.attention.forward(normed, mask, rope, position)
        x = Tensor.add(x, attn_out)
        
        # Pre-norm + FFN + Residual
        normed = self.ffn_norm.forward(x)
        ffn_out = self.ffn.forward(normed)
        x = Tensor.add(x, ffn_out)
        
        return x

class RMSNorm:
    """RMS Normalization - استاندارد Grok"""
    
    def __init__(self, dim, eps=1e-6):
        self.dim = dim
        self.eps = eps
        self.weight = [1.0] * dim  # Learnable scale parameter
    
    def forward(self, x):
        result = []
        for i in range(len(x.data)):
            row_result = []
            for j in range(len(x.data[i])):
                # Compute RMS
                rms = math.sqrt(sum(v * v for v in x.data[i][j]) / self.dim + self.eps)
                # Normalize and scale
                normed = [x.data[i][j][k] / rms * self.weight[k] for k in range(self.dim)]
                row_result.append(normed)
            result.append(row_result)
        return Tensor(result, x.shape)
class Expert:
    """یک متخصص (Expert) - Feed-Forward Network تخصصی"""
    
    def __init__(self, d_model, d_ff, expert_id):
        self.expert_id = expert_id
        self.ffn = SwiGLUFFN(d_model, d_ff)
        self.usage_count = 0
        self.load_balance_factor = 1.0
    
    def forward(self, x):
        self.usage_count += 1
        return self.ffn.forward(x)

class MoELayer:
    """Mixture of Experts Layer - دقیقاً ۸ متخصص مثل Grok"""
    
    def __init__(self, d_model, d_ff, n_experts=8, n_activated=2, dropout=0.1):
        self.d_model = d_model
        self.d_ff = d_ff
        self.n_experts = n_experts
        self.n_activated = n_activated
        
        # Create experts
        self.experts = [Expert(d_model, d_ff, i) for i in range(n_experts)]
        
        # Router (gate) network
        self.router = Tensor.xavier((d_model, n_experts))
        
        # Load balancing
        self.load_balance_lambda = 0.01
        self.expert_bias = [0.0] * n_experts
    
    def forward(self, x):
        batch_size, seq_len, _ = x.shape
        
        # Compute router logits
        router_logits = Tensor.matmul(x, self.router)
        
        # Add expert bias for load balancing
        for i in range(batch_size):
            for j in range(seq_len):
                for k in range(self.n_experts):
                    router_logits.data[i][j][k] += self.expert_bias[k]
        
        # Select top-k experts
        routing_weights, selected_experts = self._top_k_gating(router_logits)
        
        # Compute expert outputs
        output = self._compute_expert_outputs(x, routing_weights, selected_experts)
        
        # Update load balancing
        self._update_load_balancing(selected_experts)
        
        return output
    
    def _top_k_gating(self, logits):
        """انتخاب Top-K متخصص با softmax"""
        batch, seq, n_exp = logits.shape
        routing_weights = []
        selected_experts = []
        
        for i in range(batch):
            batch_weights = []
            batch_experts = []
            for j in range(seq):
                # Get logits for this token
                token_logits = logits.data[i][j]
                
                # Add noise for exploration during training
                noisy_logits = [l + random.gauss(0, 0.01) for l in token_logits]
                
                # Find top-k indices
                indexed = list(enumerate(noisy_logits))
                indexed.sort(key=lambda x: x[1], reverse=True)
                top_k = indexed[:self.n_activated]
                
                # Compute softmax weights for top-k
                top_values = [t[1] for t in top_k]
                max_val = max(top_values)
                exp_vals = [math.exp(v - max_val) for v in top_values]
                sum_exp = sum(exp_vals)
                weights = [v / sum_exp for v in exp_vals]
                
                batch_weights.append(weights)
                batch_experts.append([t[0] for t in top_k])
            
            routing_weights.append(batch_weights)
            selected_experts.append(batch_experts)
        
        return routing_weights, selected_experts
    
    def _compute_expert_outputs(self, x, routing_weights, selected_experts):
        """محاسبه خروجی متخصص‌ها با وزن‌دهی"""
        batch, seq, d_model = x.shape
        output = [[[0.0] * d_model for _ in range(seq)] for _ in range(batch)]
        
        for i in range(batch):
            for j in range(seq):
                token = x.data[i][j]
                weights = routing_weights[i][j]
                expert_ids = selected_experts[i][j]
                
                # Compute weighted sum of expert outputs
                token_tensor = Tensor([token], (1, d_model))
                for w, eid in zip(weights, expert_ids):
                    expert_out = self.experts[eid].forward(token_tensor)
                    for k in range(d_model):
                        output[i][j][k] += w * expert_out.data[0][0][k]
        
        return Tensor(output, (batch, seq, d_model))
    
    def _update_load_balancing(self, selected_experts):
        """به‌روزرسانی تعادل بار - تکنیک xAI"""
        expert_counts = [0] * self.n_experts
        for batch_experts in selected_experts:
            for token_experts in batch_experts:
                for eid in token_experts:
                    expert_counts[eid] += 1
        
        # Update bias based on load
        for i in range(self.n_experts):
            if expert_counts[i] > 0:
                self.experts[i].load_balance_factor *= 0.99
            else:
                self.experts[i].load_balance_factor *= 1.01
            self.expert_bias[i] -= self.load_balance_lambda * (expert_counts[i] - sum(expert_counts)/self.n_experts)
class GrokModel:
    """مدل کامل Grok با ۱۰۰ میلیون پارامتر"""
    
    def __init__(self, config):
        """
        config = {
            'vocab_size': 131072,        # مثل Grok
            'd_model': 1024,             # بعد مدل
            'n_heads': 16,               # تعداد سرهای توجه
            'n_kv_heads': 8,             # KV heads (Grouped Query)
            'n_layers': 24,              # تعداد لایه‌ها
            'd_ff': 4096,               # بعد Feed-Forward
            'n_experts': 8,             # تعداد متخصص‌ها
            'n_activated_experts': 2,   # متخصص‌های فعال
            'max_seq_len': 8192,        # حداکثر طول دنباله
            'dropout': 0.1,
            'use_moe': True
        }
        """
        self.config = config
        self.vocab_size = config['vocab_size']
        self.d_model = config['d_model']
        self.n_layers = config['n_layers']
        self.max_seq_len = config['max_seq_len']
        
        # Token embeddings
        self.token_embedding = Tensor.xavier((self.vocab_size, self.d_model))
        
        # Rotary embeddings
        self.rope = RotaryEmbedding(self.d_model, self.max_seq_len)
        
        # Transformer layers
        self.layers = []
        for i in range(self.n_layers):
            layer = TransformerLayer(
                d_model=self.d_model,
                n_heads=config['n_heads'],
                n_kv_heads=config['n_kv_heads'],
                d_ff=config['d_ff'],
                dropout=config['dropout']
            )
            self.layers.append(layer)
        
        # Mixture of Experts
        if config.get('use_moe', True):
            self.moe_layer = MoELayer(
                d_model=self.d_model,
                d_ff=config['d_ff'] * 2,
                n_experts=config['n_experts'],
                n_activated=config['n_activated_experts']
            )
        else:
            self.moe_layer = None
        
        # Final normalization
        self.final_norm = RMSNorm(self.d_model)
        
        # Output projection
        self.output_projection = Tensor.xavier((self.d_model, self.vocab_size))
        
        # Initialize parameters
        self._init_parameters()
    
    def _init_parameters(self):
        """پارامترهای ۱۰۰ میلیونی دستی"""
        total_params = 0
        
        # Count embedding params
        total_params += self.vocab_size * self.d_model  # Token embedding
        total_params += self.d_model * self.vocab_size   # Output projection
        
        # Count transformer layers
        for layer in self.layers:
            # Attention
            total_params += self.d_model * self.d_model * 4  # Q, K, V, O
            # FFN
            total_params += self.d_model * self.config['d_ff'] * 3  # SwiGLU
            # Norms
            total_params += self.d_model * 2  # 2 RMS norms
        
        # Count MoE
        if self.moe_layer:
            total_params += self.d_model * self.config['n_experts']  # Router
            for expert in self.moe_layer.experts:
                total_params += self.d_model * self.config['d_ff'] * 2 * 3  # SwiGLU per expert
        
        print(f"✅ Total Parameters: {total_params:,}")
        return total_params
    
    def forward(self, input_ids, mask=None):
        """Forward pass - از توکن‌ها به logits"""
        batch_size, seq_len = len(input_ids), len(input_ids[0])
        
        # Token embeddings
        x = self._embed_tokens(input_ids)
        
        # Apply rotary embeddings to input
        x = self.rope.apply_rotary(x)
        
        # Pass through transformer layers
        for i, layer in enumerate(self.layers):
            x = layer.forward(x, mask, self.rope, position=0)
        
        # Apply MoE layer
        if self.moe_layer:
            x = self.moe_layer.forward(x)
        
        # Final normalization
        x = self.final_norm.forward(x)
        
        # Project to vocabulary
        logits = Tensor.matmul(x, self.output_projection)
        
        return logits
    
    def _embed_tokens(self, input_ids):
        """تبدیل توکن‌ها به embedding"""
        batch_size = len(input_ids)
        seq_len = len(input_ids[0])
        
        embeddings = []
        for i in range(batch_size):
            seq_emb = []
            for j in range(seq_len):
                token_id = input_ids[i][j]
                seq_emb.append(self.token_embedding.data[token_id])
            embeddings.append(seq_emb)
        
        return Tensor(embeddings, (batch_size, seq_len, self.d_model))
    
    def generate(self, input_ids, max_new_tokens=100, temperature=0.8, top_p=0.9):
        """تولید متن autoregressive"""
        generated = input_ids.copy()
        
        for _ in range(max_new_tokens):
            # Forward pass
            logits = self.forward([generated[0]])
            
            # Get last token logits
            last_logits = logits.data[0][-1]
            
            # Apply temperature
            if temperature > 0:
                last_logits = [l / temperature for l in last_logits]
            
            # Top-p (nucleus) sampling
            next_token = self._sample_top_p(last_logits, top_p)
            
            # Append to generated
            generated[0].append(next_token)
            
            # Check for EOS
            if next_token == 2:  # Assuming EOS token id = 2
                break
        
        return generated
    
    def _sample_top_p(self, logits, p=0.9):
        """نمونه‌برداری Top-p (nucleus sampling)"""
        # Sort logits
        indexed = list(enumerate(logits))
        indexed.sort(key=lambda x: x[1], reverse=True)
        
        # Compute softmax
        max_val = max(logits)
        probs = [math.exp(l - max_val) for _, l in indexed]
        sum_probs = sum(probs)
        probs = [p / sum_probs for p in probs]
        
        # Cumulative sum
        cumsum = 0
        selected = []
        for i, prob in enumerate(probs):
            cumsum += prob
            selected.append(indexed[i][0])
            if cumsum >= p:
                break
        
        # Sample from selected
        selected_probs = [probs[i] for i in range(len(selected))]
        sum_selected = sum(selected_probs)
        selected_probs = [p / sum_selected for p in selected_probs]
        
        # Random choice
        r = random.random()
        cumsum = 0
        for i, prob in enumerate(selected_probs):
            cumsum += prob
            if r <= cumsum:
                return selected[i]
        
        return selected[0]
