        # Training state
        self.step = 0
        self.loss_history = []
    
    def train_step(self, batch):
        """یک گام آموزش"""
        input_ids = batch['input_ids']
        labels = batch['labels']
        
        # Forward pass
        logits = self.model.forward(input_ids)
        
        # Compute loss
        loss = self._cross_entropy_loss(logits, labels)
        
        # Backward pass (simplified gradient computation)
        self._backward_pass(loss)
        
        # Update parameters
        self._update_parameters()
        
        self.step += 1
        self.loss_history.append(loss)
        
        return loss
    
    def _cross_entropy_loss(self, logits, labels):
        """محاسبه Cross-Entropy Loss"""
        batch_size = len(logits.data)
        seq_len = len(logits.data[0])
        vocab_size = len(logits.data[0][0])
        
        total_loss = 0.0
        count = 0
        
        for i in range(batch_size):
            for j in range(seq_len):
                if j >= len(labels[i]):
                    break
                label = labels[i][j]
                if label == -100:  # Ignore index
                    continue
                
                logit = logits.data[i][j]
                
                # Softmax
                max_logit = max(logit)
                exp_logits = [math.exp(l - max_logit) for l in logit]
                sum_exp = sum(exp_logits)
                probs = [e / sum_exp for e in exp_logits]
                
                # Negative log likelihood
                total_loss -= math.log(max(probs[label], 1e-10))
                count += 1
        
        return total_loss / max(count, 1)
    
