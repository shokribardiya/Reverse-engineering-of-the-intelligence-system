class SGD:
    def __init__(self, params, lr=0.01):
        self.params = params
        self.lr = lr

    def zero_grad(self):
        for p in self.params:
            p.zero_grad()

    def step(self):
        for p in self.params:
            if p.grad is not None:
                for i in range(p.shape[0]):
                    for j in range(p.shape[1]):
                        p.data[i][j] -= self.lr * p.grad[i][j]

