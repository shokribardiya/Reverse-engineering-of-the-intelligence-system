class DataLoader:
    def __init__(self, data, batch_size, seq_len):
        self.data = data  # list of token ids
        self.batch_size = batch_size
        self.seq_len = seq_len
        self.num_batches = (len(data) - seq_len) // (batch_size * seq_len)

    def __iter__(self):
        for i in range(self.num_batches):
            batch_x = []
            batch_y = []
            for b in range(self.batch_size):
                start = i * self.batch_size * self.seq_len + b * self.seq_len
                x = self.data[start:start+self.seq_len]
                y = self.data[start+1:start+self.seq_len+1]
                batch_x.append(x)
                batch_y.append(y)
            yield batch_x, batch_y

def cross_entropy_loss(logits, targets, vocab_size):
    """
    logits: batch list of seq_len x vocab_size
    targets: batch list of seq_len
    """
    total_loss = 0.0
    for b in range(len(logits)):
        seq_logits = logits[b]
        seq_targets = targets[b]
        for t in range(len(seq_logits)):
            # softmax and NLL
            # numerical stability
            logit_row = seq_logits[t]
            max_logit = max(logit_row)
            exp_row = [math.exp(l - max_logit) for l in logit_row]
            sum_exp = sum(exp_row)
            prob = exp_row[seq_targets[t]] / sum_exp
            total_loss += -math.log(prob + 1e-9)
    return total_loss / (len(logits) * len(logits[0]))

class DistributedTrainer:
    """Simulated data-parallel training with multiprocessing."""
    def __init__(self, model, data, batch_size, seq_len, num_workers=4):
