class Embedding:
    def __init__(self, vocab_size, d_model):
        # Xavier init
        limit = math.sqrt(6.0 / (vocab_size + d_model))
        self.weight = Tensor(random_matrix(vocab_size, d_model, scale=limit), requires_grad=True)

    def forward(self, token_ids):
        # token_ids: list of ints
        return [self.weight.data[token_ids[i]][:] for i in range(len(token_ids))]

    def parameters(self):
        return [self.weight]

class MultiHeadAttention:
    def __init__(self, d_model, num_heads, dropout=0.0):
        assert d_model % num_heads == 0
        self.d_model = d_model
        self.num_heads = num_heads
        self.head_dim = d_model // num_heads
        self.scale = math.sqrt(self.head_dim)

        # Weight matrices for Q, K, V and output projection
        limit = math.sqrt(6.0 / (d_model + d_model))
        self.W_q = Tensor(random_matrix(d_model, d_model, scale=limit), requires_grad=True)
        self.W_k = Tensor(random_matrix(d_model, d_model, scale=limit), requires_grad=True)
        self.W_v = Tensor(random_matrix(d_model, d_model, scale=limit), requires_grad=True)
        self.W_o = Tensor(random_matrix(d_model, d_model, scale=limit), requires_grad=True)
        self.attention_weights = None  # store for XAI

    def forward(self, x, mask=None):
        # x: list of list (seq_len x d_model)
        # Linear projections
        Q = matmul(x, self.W_q.data)  # (seq, d_model)
        K = matmul(x, self.W_k.data)
        V = matmul(x, self.W_v.data)

        # Split into heads
        seq_len = len(x)
        Q_heads = [self._split_heads(Q, self.num_heads, self.head_dim)]
        K_heads = [self._split_heads(K, self.num_heads, self.head_dim)]
        V_heads = [self._split_heads(V, self.num_heads, self.head_dim)]
        # Q_heads[0] shape: (num_heads, seq_len, head_dim)

        # Attention
        scores = []
        for h in range(self.num_heads):
            # Q_h: (seq_len, head_dim), K_h: (seq_len, head_dim)
            Q_h = Q_heads[0][h]
            K_h = K_heads[0][h]
            V_h = V_heads[0][h]
            # scores_h = Q_h @ K_h^T / scale
            attn_scores = matmul(Q_h, transpose(K_h))  # (seq, seq)
            # scale
            attn_scores = [[val/self.scale for val in row] for row in attn_scores]
            # mask
            if mask is not None:
                for i in range(seq_len):
                    for j in range(seq_len):
                        if mask[i][j] == 0:
                            attn_scores[i][j] = -1e9
            # softmax
            attn_probs = softmax(attn_scores)  # (seq, seq)
            # store for XAI
            if h == 0 and self.attention_weights is None:
                self.attention_weights = []
            if self.attention_weights is not None:
                self.attention_weights.append(attn_probs)
            # weighted sum: attn_probs @ V_h
            head_out = matmul(attn_probs, V_h)  # (seq, head_dim)
            scores.append(head_out)
        # Concatenate heads: (seq_len, d_model)
        concat_out = []
        for i in range(seq_len):
            row = []
            for h in range(self.num_heads):
                row.extend(scores[h][i])
            concat_out.append(row)
        # Output projection
        out = matmul(concat_out, self.W_o.data)
        return out

    def _split_heads(self, x, num_heads, head_dim):
        # x: (seq_len, d_model)
        seq_len = len(x)
        heads = []
        for h in range(num_heads):
            head = []
            for i in range(seq_len):
                start = h * head_dim
                end = start + head_dim
                head.append(x[i][start:end])
            heads.append(head)
        return heads

    def parameters(self):
        return [self.W_q, self.W_k, self.W_v, self.W_o]

class FeedForward:
    def __init__(self, d_model, d_ff, dropout=0.0):
        limit = math.sqrt(6.0 / (d_model + d_ff))
        self.W1 = Tensor(random_matrix(d_model, d_ff, scale=limit), requires_grad=True)
        self.b1 = Tensor(zeros(1, d_ff), requires_grad=True)  # bias
        self.W2 = Tensor(random_matrix(d_ff, d_model, scale=limit), requires_grad=True)
        self.b2 = Tensor(zeros(1, d_model), requires_grad=True)

    def forward(self, x):
        # x: (seq_len, d_model)
        # fc1
        h = matmul(x, self.W1.data)  # (seq_len, d_ff)
        # add bias
        h = [[h[i][j] + self.b1.data[0][j] for j in range(len(self.b1.data[0]))] for i in range(len(h))]
        # gelu activation
        h = gelu(h)
        # fc2
        out = matmul(h, self.W2.data)
        out = [[out[i][j] + self.b2.data[0][j] for j in range(len(self.b2.data[0]))] for i in range(len(out))]
        return out

    def parameters(self):
        return [self.W1, self.b1, self.W2, self.b2]

class TransformerBlock:
    def __init__(self, d_model, num_heads, d_ff, dropout=0.0):
        self.attention = MultiHeadAttention(d_model, num_heads, dropout)
        self.ln1_gamma = [1.0] * d_model  # learnable later
        self.ln1_beta = [0.0] * d_model
        self.ffn = FeedForward(d_model, d_ff, dropout)
        self.ln2_gamma = [1.0] * d_model
        self.ln2_beta = [0.0] * d_model
        self.d_model = d_model

    def forward(self, x, mask=None):
        # Pre-norm architecture
        norm1 = layer_norm(x, self.ln1_gamma, self.ln1_beta)
        attn_out = self.attention.forward(norm1, mask)
        # Residual connection (we need to track as Tensor operation for autograd? 
        # Since our forward uses plain Python lists, autograd not active. We'll wrap later.
        # For pure demo, we return plain lists.
        x = [[x[i][j] + attn_out[i][j] for j in range(self.d_model)] for i in range(len(x))]
        norm2 = layer_norm(x, self.ln2_gamma, self.ln2_beta)
        ffn_out = self.ffn.forward(norm2)
        x = [[x[i][j] + ffn_out[i][j] for j in range(self.d_model)] for i in range(len(x))]
        return x

    def parameters(self):
        # Note: LayerNorm gamma/beta are currently plain lists, not Tensors.
        # To enable training, we'd wrap them as Tensor. For brevity, we keep them as lists.
        return self.attention.parameters() + self.ffn.parameters()

class GPT:
    """Decoder-only Transformer."""
    def __init__(self, vocab_size, d_model, num_heads, num_layers, d_ff, max_seq_len=512):
        self.vocab_size = vocab_size
        self.d_model = d_model
        self.num_heads = num_heads
        self.num_layers = num_layers
        self.max_seq_len = max_seq_len

        self.embedding = Embedding(vocab_size, d_model)
        self.pos_embedding = [[math.sin(pos / 10000**(2*i/d_model)) if i%2==0 else math.cos(pos / 10000**(2*i/d_model))
                               for i in range(d_model)] for pos in range(max_seq_len)]
        self.layers = [TransformerBlock(d_model, num_heads, d_ff) for _ in range(num_layers)]
        self.ln_f_gamma = [1.0] * d_model
        self.ln_f_beta = [0.0] * d_model
        # Output projection to vocab
        limit = math.sqrt(6.0 / (d_model + vocab_size))
        self.lm_head = Tensor(random_matrix(d_model, vocab_size, scale=limit), requires_grad=True)

        # For XAI: attention weights from the last layer
        self.last_attention_weights = None

    def forward(self, input_ids, attention_mask=None):
        # input_ids: list of token indices
        seq_len = len(input_ids)
        # Embed
        token_emb = self.embedding.forward(input_ids)  # list of lists
        # Add position embedding
        x = [[token_emb[i][j] + self.pos_embedding[i][j] for j in range(self.d_model)] for i in range(seq_len)]
        # Apply transformer blocks
        for layer in self.layers:
            x = layer.forward(x, mask=attention_mask)
        # Final layer norm
        x = layer_norm(x, self.ln_f_gamma, self.ln_f_beta)
        # Language model head (linear)
        logits = matmul(x, self.lm_head.data)  # (seq_len, vocab_size)
        # Save attention weights from last block for XAI
        self.last_attention_weights = self.layers[-1].attention.attention_weights
        return logits

    def parameters(self):
        params = self.embedding.parameters()
        for layer in self.layers:
            params.extend(layer.parameters())
        params.append(self.lm_head)
        return params

    def count_parameters(self):
        total = 0
        for p in self.parameters():
            total += p.shape[0] * p.shape[1]
        return total

