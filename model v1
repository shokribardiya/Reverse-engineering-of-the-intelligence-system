class Tensor:
    """Scalar/Vector/Matrix with automatic gradient tracking."""
    def __init__(self, data, requires_grad=False, _children=()):
        self.data = self._ensure_list(data)
        self.shape = self._infer_shape(self.data)
        self.requires_grad = requires_grad
        self.grad = None
        self._backward = lambda: None
        self._prev = set(_children)

    def _ensure_list(self, data):
        if isinstance(data, (int, float)):
            return [[data]]  # 1x1 matrix
        if isinstance(data, list):
            if len(data) == 0:
                return [[]]
            if isinstance(data[0], list):
                return data
            else:
                return [data]  # vector as 1xN matrix
        raise ValueError("Unsupported data type")

    def _infer_shape(self, data):
        rows = len(data)
        cols = len(data[0]) if rows > 0 else 0
        return (rows, cols)

    def zero_grad(self):
        self.grad = None

    def __add__(self, other):
        other = other if isinstance(other, Tensor) else Tensor(other)
        assert self.shape == other.shape, "Shape mismatch"
        out = Tensor([[self.data[i][j] + other.data[i][j] for j in range(self.shape[1])] for i in range(self.shape[0])],
                     requires_grad=self.requires_grad or other.requires_grad, _children=(self, other))
        def _backward():
            if self.requires_grad:
                self.grad = _add_grad(self.grad, out.grad, self.shape)
            if other.requires_grad:
                other.grad = _add_grad(other.grad, out.grad, other.shape)
        out._backward = _backward
        return out

    def __mul__(self, other):
        other = other if isinstance(other, Tensor) else Tensor(other)
        if self.shape == other.shape:
            # Element-wise
            out = Tensor([[self.data[i][j] * other.data[i][j] for j in range(self.shape[1])] for i in range(self.shape[0])],
                         requires_grad=self.requires_grad or other.requires_grad, _children=(self, other))
            def _backward():
                if self.requires_grad:
                    self.grad = _add_grad(self.grad, _elem_mul_grad(other.data, out.grad), self.shape)
                if other.requires_grad:
                    other.grad = _add_grad(other.grad, _elem_mul_grad(self.data, out.grad), other.shape)
            out._backward = _backward
        else:
            # Matrix multiplication (self @ other)
            assert self.shape[1] == other.shape[0], f"Matmul shape mismatch {self.shape} vs {other.shape}"
            out_rows, out_cols = self.shape[0], other.shape[1]
            out_data = [[sum(self.data[i][k] * other.data[k][j] for k in range(self.shape[1]))
                         for j in range(out_cols)] for i in range(out_rows)]
            out = Tensor(out_data, requires_grad=self.requires_grad or other.requires_grad, _children=(self, other))
            def _backward():
                if self.requires_grad:
                    # grad_self = out.grad @ other.T
                    grad_self = matmul(out.grad, transpose(other.data))
                    self.grad = _add_grad(self.grad, grad_self, self.shape)
                if other.requires_grad:
                    # grad_other = self.T @ out.grad
                    grad_other = matmul(transpose(self.data), out.grad)
                    other.grad = _add_grad(other.grad, grad_other, other.shape)
            out._backward = _backward
        return out

    def __matmul__(self, other):
        return self.__mul__(other)

    def __neg__(self):
        return self * -1

    def __sub__(self, other):
        return self + (-other)

    def __truediv__(self, other):
        return self * (1.0 / other)

    def __pow__(self, exp):
        out = Tensor([[self.data[i][j] ** exp for j in range(self.shape[1])] for i in range(self.shape[0])],
                     requires_grad=self.requires_grad, _children=(self,))
        def _backward():
            if self.requires_grad:
                grad_data = [[exp * (self.data[i][j] ** (exp-1)) * out.grad[i][j] 
                              for j in range(self.shape[1])] for i in range(self.shape[0])]
                self.grad = _add_grad(self.grad, grad_data, self.shape)
        out._backward = _backward
        return out

    def exp(self):
        out_data = [[math.exp(self.data[i][j]) for j in range(self.shape[1])] for i in range(self.shape[0])]
        out = Tensor(out_data, requires_grad=self.requires_grad, _children=(self,))
        def _backward():
            if self.requires_grad:
                grad_data = [[out.data[i][j] * out.grad[i][j] for j in range(self.shape[1])] for i in range(self.shape[0])]
                self.grad = _add_grad(self.grad, grad_data, self.shape)
        out._backward = _backward
        return out

    def log(self):
        out_data = [[math.log(self.data[i][j]) for j in range(self.shape[1])] for i in range(self.shape[0])]
        out = Tensor(out_data, requires_grad=self.requires_grad, _children=(self,))
        def _backward():
            if self.requires_grad:
                grad_data = [[(1.0 / self.data[i][j]) * out.grad[i][j] for j in range(self.shape[1])] for i in range(self.shape[0])]
                self.grad = _add_grad(self.grad, grad_data, self.shape)
        out._backward = _backward
        return out

    def sum(self, dim=None):
        if dim is None:
            total = sum(sum(row) for row in self.data)
            out = Tensor(total, requires_grad=self.requires_grad, _children=(self,))
            def _backward():
                if self.requires_grad:
                    self.grad = _add_grad(self.grad, [[out.grad[0][0]]*self.shape[1]]*self.shape[0], self.shape)
            out._backward = _backward
            return out
        elif dim == 0:
            out_data = [[sum(self.data[i][j] for i in range(self.shape[0])) for j in range(self.shape[1])]]
            out = Tensor(out_data, requires_grad=self.requires_grad, _children=(self,))
            def _backward():
                if self.requires_grad:
                    grad = [[out.grad[0][j] for j in range(self.shape[1])] for _ in range(self.shape[0])]
                    self.grad = _add_grad(self.grad, grad, self.shape)
            out._backward = _backward
            return out
        elif dim == 1:
            out_data = [[sum(row) for row in self.data]]
            out = Tensor(out_data, requires_grad=self.requires_grad, _children=(self,))
            def _backward():
                if self.requires_grad:
                    grad = [[out.grad[0][i] for _ in range(self.shape[1])] for i in range(self.shape[0])]
                    self.grad = _add_grad(self.grad, grad, self.shape)
            out._backward = _backward
            return out
        else:
            raise NotImplementedError

    def __repr__(self):
        return f"Tensor(shape={self.shape}, data={self.data[:2]}...)"

    def backward(self):
        if self.shape != (1, 1):
            raise RuntimeError("Backward called on non-scalar tensor")
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        build_topo(self)
        self.grad = [[1.0]]
        for node in reversed(topo):
            node._backward()

# Helper functions
def _add_grad(existing, new, shape):
    if existing is None:
        return new
    return [[existing[i][j] + new[i][j] for j in range(shape[1])] for i in range(shape[0])]

def _elem_mul_grad(other_data, out_grad):
    return [[other_data[i][j] * out_grad[i][j] for j in range(len(out_grad[0]))] for i in range(len(out_grad))]

def matmul(a, b):
    rows_a, cols_a = len(a), len(a[0])
    rows_b, cols_b = len(b), len(b[0])
    assert cols_a == rows_b
    return [[sum(a[i][k] * b[k][j] for k in range(cols_a)) for j in range(cols_b)] for i in range(rows_a)]

def transpose(a):
    return list(map(list, zip(*a)))

def zeros(rows, cols):
    return [[0.0]*cols for _ in range(rows)]

def random_matrix(rows, cols, scale=1.0):
    return [[random.uniform(-scale, scale) for _ in range(cols)] for _ in range(rows)]

def softmax(logits):
    # logits: 1xN or Nx1
    if len(logits) == 1:
        row = logits[0]
        max_val = max(row)
        exp_row = [math.exp(x - max_val) for x in row]
        sum_exp = sum(exp_row)
        return [[e/sum_exp for e in exp_row]]
    else:
        # assume column vector
        col = [r[0] for r in logits]
        max_val = max(col)
        exp_col = [math.exp(x - max_val) for x in col]
        sum_exp = sum(exp_col)
        return [[e/sum_exp] for e in exp_col]

def layer_norm(x, gamma, beta, eps=1e-5):
    # x: (rows, cols)
    mean = sum(sum(row) for row in x) / (len(x)*len(x[0]))
    var = sum(sum((val - mean)**2 for val in row) for row in x) / (len(x)*len(x[0]))
    std = math.sqrt(var + eps)
    return [[gamma[j] * (x[i][j] - mean) / std + beta[j] for j in range(len(x[0]))] for i in range(len(x))]

def relu(x):
    return [[max(0, val) for val in row] for row in x]

def gelu(x):
    return [[0.5*val*(1+math.tanh(math.sqrt(2/math.pi)*(val+0.044715*val**3))) for val in row] for row in x]

