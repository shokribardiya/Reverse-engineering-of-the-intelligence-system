class XAIEngine:
    def __init__(self, model):
        self.model = model

    def get_attention_weights(self, input_ids):
        """Run forward and return attention matrices from last layer."""
        _ = self.model.forward(input_ids)
        return self.model.last_attention_weights

    def integrated_gradients(self, input_ids, target_token_idx, steps=50):
        """
        Compute Integrated Gradients for a specific output logit w.r.t input embeddings.
        We approximate by scaling input from zero embedding to actual.
        """
        seq_len = len(input_ids)
        d_model = self.model.d_model
        # baseline: zero embedding
        baseline_emb = [[0.0]*d_model for _ in range(seq_len)]
        actual_emb = self.model.embedding.forward(input_ids)
        # add pos embedding to actual
        actual_emb = [[actual_emb[i][j] + self.model.pos_embedding[i][j] for j in range(d_model)] for i in range(seq_len)]
        # Interpolation
        integrated_grad = [[0.0]*d_model for _ in range(seq_len)]
        for step in range(1, steps+1):
            alpha = step / steps
            interpolated = [[(1-alpha)*baseline_emb[i][j] + alpha*actual_emb[i][j] for j in range(d_model)] for i in range(seq_len)]
            # We need gradients of logit w.r.t this interpolated embedding.
            # Because our forward uses plain Python lists, we can't autograd directly.
            # For demonstration, we approximate gradient numerically.
            grad_approx = self._numerical_gradient(interpolated, input_ids, target_token_idx)
            for i in range(seq_len):
                for j in range(d_model):
                    integrated_grad[i][j] += grad_approx[i][j] * (actual_emb[i][j] - baseline_emb[i][j]) / steps
        return integrated_grad

    def _numerical_gradient(self, emb, input_ids, target_token_idx, epsilon=1e-4):
        """Compute gradient of logit w.r.t embedding via finite differences."""
        seq_len = len(emb)
        d_model = len(emb[0])
        grad = zeros(seq_len, d_model)
        # We need a forward function that takes embedding and returns logits.
        # Modify forward to skip embedding and position addition. For simplicity, we reuse model's layers.
        # Original model.forward uses token_ids and does embedding+pos inside.
        # Here we need a forward_from_emb(emb) function. We'll create a helper.
        base_logit = self._forward_from_emb(emb)[target_token_idx]
        for i in range(seq_len):
            for j in range(d_model):
                original = emb[i][j]
                emb[i][j] = original + epsilon
                new_logit = self._forward_from_emb(emb)[target_token_idx]
                grad[i][j] = (new_logit - base_logit) / epsilon
                emb[i][j] = original
        return grad

    def _forward_from_emb(self, emb):
        # Simulate model layers starting from embedding (already has positional info)
        x = emb
        for layer in self.model.layers:
            x = layer.forward(x)
        x = layer_norm(x, self.model.ln_f_gamma, self.model.ln_f_beta)
        logits = matmul(x, self.model.lm_head.data)  # seq_len x vocab_size
        return [logits[i][0] for i in range(len(logits))]  # assume vocab dim 1 for simplicity

    def lime_explanation(self, input_ids, target_token_idx, num_samples=100, kernel_width=25):
        """LIME-like local explanation for text input."""
        # For simplicity, we perturb the input by removing/replacing tokens.
        seq_len = len(input_ids)
        # Original prediction probability
        base_logit = self._forward_logit(input_ids)[target_token_idx]
        # Generate perturbed samples
        samples = []
        distances = []
        for _ in range(num_samples):
            # Randomly mask some tokens (set to 0 token)
            masked = input_ids.copy()
            for i in range(seq_len):
                if random.random() < 0.5:
                    masked[i] = 0  # assume 0 is pad/unknown
            samples.append(masked)
            distances.append(self._kernel(seq_len, sum(1 for i in range(seq_len) if masked[i] != input_ids[i]), kernel_width))
        # Get predictions for samples
        preds = [self._forward_logit(s)[target_token_idx] for s in samples]
        # Linear regression to get feature importance (simplified)
        # Use weighted least squares
        # For each token j, feature = 1 if token is original else 0
        X = [[1 if s[i] == input_ids[i] else 0 for i in range(seq_len)] for s in samples]
        # Solve linear model: weights = (X^T W X)^{-1} X^T W y
        W = [[distances[i] if j==i else 0 for j in range(num_samples)] for i in range(num_samples)]
        XtW = matmul(transpose(X), W)
        XtWX = matmul(XtW, X)
        XtWy = matmul(XtW, [[preds[i]] for i in range(num_samples)])
        # Solve using simple Gaussian elimination (omitted for brevity; use pseudo-inverse)
        # Return token importance as coefficients
        return [XtWy[i][0] for i in range(seq_len)]  # simplified

    def _kernel(self, seq_len, num_changes, width):
        return math.exp(-num_changes / width)

    def _forward_logit(self, input_ids):
        logits = self.model.forward(input_ids)
        # logits is list of lists (seq_len, vocab_size). Assume vocab size 1 for simplicity? Adjust.
        return [logits[i][0] for i in range(len(logits))]

